# Normalise line endings so a clone on any platform behaves the same and so no
# deploy step rewrites files. CalSnap's own scripts are written with LF, which is
# what the test suites and tools assume.
* text=auto eol=lf

# Binary assets must never be converted.
*.png binary
*.ico binary

# Windows scripts keep CRLF so they run without complaint from older shells.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Generated or local-only files, if one ever slips past .gitignore.
*.ics linguist-generated=false
